# Какой вариант запуска использовать (см. README, «Готовые варианты запуска»):
#   proxy  — стандартный вариант: приложение + база данных + встроенный
#            nginx с HTTPS (порты 80/443). Подходит, если на сервере больше
#            ничего не работает на этих портах.
#   (пусто) — без встроенного прокси: только приложение + база данных,
#            приложение слушает 127.0.0.1:3000 — используйте, если на
#            сервере уже есть свой nginx/reverse proxy.
COMPOSE_PROFILES=proxy

# Пароль базы данных PostgreSQL. Используется docker-compose.yml при создании
# контейнера базы данных и контейнера приложения. ОБЯЗАТЕЛЬНО заменить перед
# продакшеном на надёжный случайный пароль.
POSTGRES_PASSWORD=change_me

# Секрет для подписи сессионных cookie Auth.js. Сгенерировать: `npx auth secret`
# или `openssl rand -base64 32`. ОБЯЗАТЕЛЬНО заменить перед продакшеном.
AUTH_SECRET=change_me_to_a_random_64_char_string

# Публичный URL, на котором развёрнута система (используется Auth.js
# для формирования callback-адресов). Во внутренней сети — адрес сервера.
# Приложение работает за прокси-сервером (docker/nginx.conf) по HTTPS
# на 443 порту, поэтому URL обычно начинается с https:// — см. README,
# раздел «HTTPS и сертификат».
AUTH_URL=https://localhost

# Строка подключения к PostgreSQL для запуска скриптов (миграции, создание
# администратора) НАПРЯМУЮ, вне Docker — например, при локальной разработке.
# Внутри Docker Compose контейнер приложения подключается к базе данных по
# имени сервиса "db" и паролю POSTGRES_PASSWORD, а не по этой строке.
# Формат: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://materials_app:change_me@localhost:5432/materials

# production | development
NODE_ENV=development
